# Same-origin API path. Vercel rewrites this path to the Render backend.
VITE_API_BASE_URL=/api/v1

# Do not put long-lived TURN credentials in VITE_ variables: Vite embeds
# VITE_ values in public browser JavaScript. Use short-lived credentials only.
# VITE_TURN_URLS=
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
