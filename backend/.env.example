# Local development only. In Render, set these in the service Environment tab.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DB?sslmode=require
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# Render's filesystem is ephemeral. /media is same-origin proxied by Vercel.
STORAGE_PUBLIC_BASE_URL=/media

# Optional integrations; leave empty to keep them disabled for the free beta.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
STORAGE_URL=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
